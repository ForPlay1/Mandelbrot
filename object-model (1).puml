@startuml ObjectModel_Clean

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
hide circle
hide empty members
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12

package "fractalcipher.domain" {
  class Image <<Entity>> {
    - image: BufferedImage
    + {static} loadFromFile(file): Image
    + getResolution(): String
    + isBlackAndWhite(): boolean
  }

  abstract class Cipher <<Template Method>> {
    # imageInput: Image
    # imageOutput: Image
    + encrypt(): void
    + {abstract} decrypt(): void
    # {abstract} preprocess(): void
    # {abstract} process(): void
    # {abstract} postprocess(): void
  }

  class FractalChaosCipher {
    - mode: EncryptionMode
  }

  enum EncryptionMode {
    PERMUTATION_ONLY
    DIFFUSION_ONLY
    FULL
  }
}

package "fractalcipher.config" {
  enum CipherMode {
    ENCRYPT
    DECRYPT
    BENCHMARK
    BENCRYPT
    BENDECRYPT
  }

  enum PermutationMode {
    MANDELBROT
    JULIA
    CANTOR
    BURNING_SHIP
    SIERPINSKI
    DRAGON
  }

  enum DiffusionMode {
    LOGISTIC
    HENON
    TENT
    LORENZ
    ROSSLER
    ARNOLD
    NULL
  }
}

package "fractalcipher.model" {
  interface PermutationSource <<Strategy>> {
    + generatePermutation(length, params): int[]
    + getName(): String
  }

  interface DiffusionSource <<Strategy>> {
    + generateStream(length, params): byte[]
    + getName(): String
  }

  class PermutationSourceFactory <<Factory>> {
    + get(name): PermutationSource
    + availableNames(): Set<String>
  }

  class DiffusionSourceFactory <<Factory>> {
    + get(name): DiffusionSource
    + availableNames(): Set<String>
  }

  class KeyManager <<utility>> {
    + saveKey(key, file): void
    + loadKey(file): EncryptionKey
  }
}

package "fractalcipher.controller" {
  class CipherController <<Controller>> {
    + processSelection(userParams): void
    - runSingle(...): void
    - runBatchEncrypt(...): void
    - runBenchmark(...): void
  }
  note bottom of CipherController
    Оркестратор. Принимает словарь из View,
    вызывает фабрики, шифр и бенчмарк.
    Управляет потоками и файлами.
  end note
}

package "fractalcipher.view" {
  class MainView <<View>> {
    - {static} userParams: Map<Class<?>, Object>
    + getRoot(): Parent
    + {static} getUserParams(): Map
    - onRun(): void
    - resolveConflicts(...): Set<File>
  }
  note bottom of MainView
    Собирает выбор пользователя (enums),
    обрабатывает конфликты имён файлов
    и публикует userParams для Controller.
  end note
}

package "fractalcipher.metrics" {
  class BenchmarkRunner <<utility>> {
    + {static} runFull(factories, image, key): List
  }

  class BenchmarkResult <<DTO>> {
    + permutationName: String
    + diffusionName: String
    + npcr: double
    + entropy: double
    + toCsvRow(): String
  }

  class ImageMetrics <<utility>> {
    + {static} npcr(img1, img2): double
    + {static} entropy(img): double
  }
}

package "fractalcipher.run" {
  class Main <<Entry Point>> {
    + main(args): void
    + start(stage): void
  }
}

' ============================================================
' СВЯЗИ (Relationships)
' ============================================================

Cipher <|-- FractalChaosCipher
Cipher o-- Image : "шифрует"

' Мост между UI и логикой через статический словарь
MainView ..> Main : "публикует userParams"
Main ..> CipherController : "создает и вызывает"
Main ..> MainView : "запускает UI"

' Контроллер использует фабрики и шифр
CipherController --> PermutationSourceFactory
CipherController --> DiffusionSourceFactory
CipherController --> Cipher : "вызывает encrypt/decrypt"
CipherController --> BenchmarkRunner : "запускает"
CipherController ..> CipherMode
CipherController ..> PermutationMode
CipherController ..> DiffusionMode

' Шифр зависит от интерфейсов (внедряются через конструктор)
FractalChaosCipher --> PermutationSource
FractalChaosCipher --> DiffusionSource
FractalChaosCipher --> EncryptionMode

' View использует Config (Enums для кнопок)
MainView ..> CipherMode
MainView ..> PermutationMode
MainView ..> DiffusionMode

' Бенчмарк создает шифры, использует метрики и возвращает DTO
BenchmarkRunner ..> FractalChaosCipher : "создает"
BenchmarkRunner ..> ImageMetrics : "считает"
BenchmarkRunner ..> BenchmarkResult : "создает"

@enduml